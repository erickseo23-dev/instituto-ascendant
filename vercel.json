{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/clarimental",
      "destination": "/clarimental/index.html"
    },
    {
      "source": "/sano-el-dolor-que-me-condicionaba",
      "destination": "/sano-el-dolor-que-me-condicionaba/index.html"
    },
    {
      "source": "/todo-lo-bueno-me-sucede",
      "destination": "/todo-lo-bueno-me-sucede/index.html"
    },
    {
      "source": "/todo-lo-bueno-masterclass",
      "destination": "/todo-lo-bueno-masterclass/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
